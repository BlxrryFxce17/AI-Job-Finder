# MongoDB Connection
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Secret (REQUIRED - must be set in production!)
JWT_SECRET=your_secure_random_string_at_least_32_chars

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Public URL (for tracking links - set to your production URL)
PUBLIC_URL=https://your-domain.com

# Node Environment
NODE_ENV=development

# Port
PORT=5000

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth (for Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (fallback SMTP - not recommended for Render)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Adzuna Jobs API
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Hunter.io (for email discovery)
HUNTER_API_KEY=your_hunter_api_key

# Serper.dev (for Google search dorking)
SERPER_API_KEY=your_serper_api_key